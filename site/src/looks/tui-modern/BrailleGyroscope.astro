---
// The loops, spinning: a gyroscope drawn in braille, two dots across and four down in every character cell. The change
// is the ball in the middle; around it, three rings of different sizes turn at their own speeds, the small one fastest,
// as short loops run often and long ones seldom. A bright pulse runs round each ring: a change going through its loop.
// Shading is ordered dithering of the dots; each cell takes its colour from the light on it, from hot pink in the shade
// to cyan in full light. Still under reduced motion, paused while off the screen.
export interface Props {
  /** Columns and rows of character cells. */
  cols?: number;
  rows?: number;
}

const { cols = 56, rows = 26 } = Astro.props;
---

<pre class="gyroscope" data-cols={cols} data-rows={rows} aria-hidden="true"></pre>

<script>
  const TAU = Math.PI * 2;
  // A 4×4 ordered-dither matrix: a dot is on when its light is over its threshold.
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
  // The bit of each dot in a braille cell, by column (0, 1) and row (0 to 3).
  const BIT = [
    [0x01, 0x02, 0x04, 0x40],
    [0x08, 0x10, 0x20, 0x80],
  ];
  const SHADES = 8;

  type Vec = [number, number, number];
  type Mat = number[];
  const unit = (v: Vec): Vec => {
    const l = Math.hypot(v[0], v[1], v[2]) || 1;
    return [v[0] / l, v[1] / l, v[2] / l];
  };
  // The rotation by an angle about an axis, and the product of two rotations, as 3×3 matrices in rows.
  const rot = (axis: Vec, a: number): Mat => {
    const [x, y, z] = unit(axis);
    const c = Math.cos(a), s = Math.sin(a), C = 1 - c;
    return [
      c + x * x * C, x * y * C - z * s, x * z * C + y * s,
      y * x * C + z * s, c + y * y * C, y * z * C - x * s,
      z * x * C - y * s, z * y * C + x * s, c + z * z * C,
    ];
  };
  const mul = (a: Mat, b: Mat): Mat => {
    const r = new Array(9);
    for (let i = 0; i < 3; i++)
      for (let j = 0; j < 3; j++) r[i * 3 + j] = a[i * 3] * b[j] + a[i * 3 + 1] * b[3 + j] + a[i * 3 + 2] * b[6 + j];
    return r;
  };

  // A part of the gyroscope: points on its surface with their normals, where each point is along its ring (0 to 1),
  // how the part turns with time, and the pulse that runs round it.
  interface Part {
    n: number;
    P: Float32Array;
    N: Float32Array;
    along: Float32Array;
    motion?: (t: number) => Mat;
    pulse?: { speed: number; width: number };
  }

  // A ring: a thin tube of radius r round a circle of radius R, in the plane z = 0.
  const ring = (R: number, r: number, around: number, across: number): Part => {
    const n = around * across;
    const part: Part = { n, P: new Float32Array(n * 3), N: new Float32Array(n * 3), along: new Float32Array(n) };
    let k = 0;
    for (let i = 0; i < around; i++) {
      const u = (i / around) * TAU, cu = Math.cos(u), su = Math.sin(u);
      for (let j = 0; j < across; j++) {
        const v = (j / across) * TAU, cv = Math.cos(v), sv = Math.sin(v);
        const nx = cv * cu, ny = cv * su, nz = sv;
        part.P.set([R * cu + r * nx, R * su + r * ny, r * nz], k * 3);
        part.N.set([nx, ny, nz], k * 3);
        part.along[k++] = i / around;
      }
    }
    return part;
  };

  // The ball in the middle.
  const ball = (r: number, around: number): Part => {
    const down = Math.round(around / 2);
    const n = around * down;
    const part: Part = { n, P: new Float32Array(n * 3), N: new Float32Array(n * 3), along: new Float32Array(n) };
    let k = 0;
    for (let i = 0; i < around; i++)
      for (let j = 0; j < down; j++) {
        const u = (i / around) * TAU, v = ((j + 0.5) / down) * Math.PI;
        const nx = Math.sin(v) * Math.cos(u), ny = Math.sin(v) * Math.sin(u), nz = Math.cos(v);
        part.P.set([r * nx, r * ny, r * nz], k * 3);
        part.N.set([nx, ny, nz], k * 3);
        k++;
      }
    return part;
  };

  // The three rings, each on its own axis and speed: the outer one slowest, the inner one fastest.
  const outer = ring(2.75, 0.15, 713, 44);
  outer.motion = (t) => mul(rot([0, 1, 0], 1.2), rot([1, 0, 0], t * 0.35));
  outer.pulse = { speed: 0.12, width: 0.03 };
  const middle = ring(1.95, 0.15, 505, 44);
  middle.motion = (t) => mul(rot([1, 0, 0], 0.5), rot([0, 1, 0], t * 0.8));
  middle.pulse = { speed: 0.25, width: 0.035 };
  const inner = ring(1.2, 0.15, 311, 44);
  inner.motion = (t) => mul(rot([0, 0, 1], 0.9), rot([1, 1, 0], t * 1.7));
  inner.pulse = { speed: 0.5, width: 0.04 };
  const parts = [outer, middle, inner, ball(0.5, 150)];

  // The whole, tilted toward the viewer and turning slowly; the light from above, a little right and in front.
  const view = (t: number) => mul(rot([1, 0, 0], 0.55), rot([0, 0, 1], t * 0.12));
  const LIGHT = unit([0.2, -0.9, -0.6]);

  for (const pre of document.querySelectorAll<HTMLElement>('.gyroscope')) {
    const cols = Number(pre.dataset.cols);
    const rows = Number(pre.dataset.rows);
    const W = cols * 2;
    const H = rows * 4;
    const z = new Float32Array(W * H);
    const lum = new Float32Array(W * H);

    // The shape of a dot's place, so the rings stay round whatever the font: two dots across a cell, four down a line.
    // Measured again once the webfont is in, since a fallback font has other proportions.
    let aspect = 1;
    const measure = () => {
      const probe = document.createElement('span');
      probe.textContent = '⣿'.repeat(10);
      pre.append(probe);
      const box = probe.getBoundingClientRect();
      probe.remove();
      const lineHeight = parseFloat(getComputedStyle(pre).lineHeight) || box.height;
      aspect = box.width / 10 / 2 / (lineHeight / 4) || 1;
    };
    measure();
    document.fonts?.ready.then(() => {
      measure();
      frame(T);
    });

    const frame = (t: number) => {
      z.fill(0);
      lum.fill(-9);
      const G = view(t);
      const kx = W * 0.6;
      const ky = kx * aspect;
      for (const p of parts) {
        const [a, b, c, d, e, f, g, h, i] = p.motion ? mul(G, p.motion(t)) : G;
        const { P, N } = p;
        for (let s = 0; s < p.n; s++) {
          const x0 = P[s * 3], y0 = P[s * 3 + 1], z0 = P[s * 3 + 2];
          const D = 1 / (g * x0 + h * y0 + i * z0 + 5);
          const x = (W / 2 + kx * D * (a * x0 + b * y0 + c * z0)) | 0;
          const y = (H / 2 + ky * D * (d * x0 + e * y0 + f * z0)) | 0;
          if (y < 0 || y >= H || x < 0 || x >= W) continue;
          const o = x + W * y;
          if (D <= z[o]) continue;
          z[o] = D;
          const nx = N[s * 3], ny = N[s * 3 + 1], nz = N[s * 3 + 2];
          let l =
            (a * nx + b * ny + c * nz) * LIGHT[0] +
            (d * nx + e * ny + f * nz) * LIGHT[1] +
            (g * nx + h * ny + i * nz) * LIGHT[2];
          // The pulse: the stretch of the ring it is on lights up fully.
          if (p.pulse) {
            const off = Math.abs(((((p.along[s] - t * p.pulse.speed) % 1) + 1.5) % 1) - 0.5);
            if (off < p.pulse.width) l = Math.max(l, 0.95);
          }
          lum[o] = l;
        }
      }
      let html = '';
      for (let cy = 0; cy < rows; cy++) {
        let run = '';
        let shade = -2;
        for (let cx = 0; cx < cols; cx++) {
          let bits = 0;
          let sum = 0;
          let lit = 0;
          for (let dx = 0; dx < 2; dx++) {
            for (let dy = 0; dy < 4; dy++) {
              const x = cx * 2 + dx;
              const y = cy * 4 + dy;
              const l = lum[x + W * y];
              if (l < -8) continue;
              // Full light goes solid; the shaded side keeps a sparse dusting of dots, so the whole ring reads.
              const v = Math.min(1, 0.07 + 1.05 * Math.max(0, l));
              if (v > BAYER[(y & 3) * 4 + (x & 3)]) {
                bits |= BIT[dx][dy];
                sum += v;
                lit++;
              }
            }
          }
          const s = lit ? Math.min(SHADES - 1, Math.floor((sum / lit) * SHADES)) : -1;
          if (s !== shade) {
            if (run) html += shade < 0 ? run : `<span class="g${shade}">${run}</span>`;
            run = '';
            shade = s;
          }
          run += bits ? String.fromCharCode(0x2800 + bits) : ' ';
        }
        if (run) html += shade < 0 ? run : `<span class="g${shade}">${run}</span>`;
        html += '\n';
      }
      pre.innerHTML = html;
    };

    let T = 0;
    frame(T);

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    let running = false;
    let last = 0;
    const step = (now: number) => {
      if (!visible || still.matches) {
        running = false;
        return;
      }
      if (now - last > 33) {
        T += 0.05;
        frame(T);
        last = now;
      }
      requestAnimationFrame(step);
    };
    const start = () => {
      if (running || !visible || still.matches) return;
      running = true;
      requestAnimationFrame(step);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(pre);
    still.addEventListener('change', start);
    start();
  }
</script>
